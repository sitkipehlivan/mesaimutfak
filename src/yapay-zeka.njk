<script>
(function () { var b = document.getElementById('mcpCopy'), c = document.getElementById('mcpUrl'); if (!b) return;
  b.addEventListener('click', function () { var t = c.textContent; (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(function () { b.textContent = 'Kopyalandı'; setTimeout(function () { b.textContent = 'Kopyala'; }, 1600); }, function () { var r = document.createRange(); r.selectNodeContents(c); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }); });
})();
</script>
