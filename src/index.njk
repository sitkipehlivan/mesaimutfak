---
layout: base.njk
isHome: true
---
{%- set heroR = collections.tarifler | bySlug(home.hero.slug) -%}

{# 1. Haftanın tarifi #}
<div class="wrap hero-solo">
  <a class="feature" href="{{ heroR.url | link }}">
    <span class="photo">{% visual { image: heroR.data.image, heroImage: home.hero.heroImage, imageAlt: heroR.data.imageAlt, title: heroR.data.title, art: heroR.data.art }, 'scene', heroR.fileSlug, true %}</span>
    {% if not (home.hero.heroImage or heroR.data.image) %}<span class="ph-tag">Fotoğraf alanı</span>{% endif %}
    <span class="over">
      <span class="eyebrow">{{ home.hero.eyebrow }}</span>
      <h1>{{ heroR.data.title }}</h1>
      <span class="meta"><span>{{ heroR.data.prep + heroR.data.cook }} dk</span><span>{{ heroR.data.serv }} kişilik</span><span>{{ heroR.data.lvl }}</span></span>
    </span>
  </a>
</div>

{# 2. Kategoriler #}
<section class="home-sec" id="kategoriler">
  <div class="wrap">
    <div class="home-head">
      <h2>Kategoriler</h2>
      <a class="tool-btn" href="{{ '/bugun-ne-pisirsem/' | link }}">Bugün ne pişirsem? <span aria-hidden="true">→</span></a>
    </div>
    <div class="cats cats-sm">
      {% for c in categories.types %}
      <a class="cat" href="{{ ('/kategori/' + c.k + '/') | link }}"><span class="ic" style="background:{{ c.k | tint }}">{% plateArt c.art, c.k %}</span><b>{{ c.l }}</b></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 3. Sana göre #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Sana göre</h2><span class="home-sub">Beslenme tercihi ve vakit</span></div>
    <div class="diet">
      {% for c in categories.diets %}
      <a class="dcard{% if c.wc %} wc{% endif %}" href="{{ ('/kategori/' + c.k + '/') | link }}"><span class="ic" style="{% if not c.wc %}background:{{ c.k | tint }}{% endif %}">{% plateArt c.art, c.k %}</span><span><b>{{ c.l }}</b><span>{{ c.s }}</span><em>{{ (collections.tarifler | inCat(c.k)).length }} tarif</em></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 4. En çok bakılanlar #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Bu hafta en çok bakılanlar</h2><a class="home-more" href="{{ '/tarifler/' | link }}">Tüm tarifler →</a></div>
    <div class="pop-row">
      {% for r in collections.tarifler | bySlugs(home.popular) %}
      <a class="pop-item" href="{{ r.url | link }}"><span class="th" style="background:{{ r.fileSlug | tint }}">{% visual r.data, 'plate', r.fileSlug %}</span><span><b><span class="n">{{ loop.index }}</span>{{ r.data.title }}</b><span>{{ r.data.prep + r.data.cook }} dk · {{ r.data.lvl }}</span></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 5. Bugün ne pişirsem? #}
<section class="home-sec">
  <div class="wrap">
    <div class="picker-promo">
      <div>
        <div class="eyebrow">Karar veremeyenlere</div>
        <h2>Bugün ne pişirsem?</h2>
        <p>Ruh halini seç, sana uygun tarifi bulalım. Tür, zorluk ve süreyi de ayarlayabilirsin.</p>
      </div>
      <div class="mood-links">
        {% for m in moods %}<a href="{{ ('/bugun-ne-pisirsem/#' + m.k) | link }}"><b>{{ m.l }}</b><span>{{ m.s }}</span></a>{% endfor %}
      </div>
    </div>
  </div>
</section>

{# 6. Hızlı tarifler #}
<section class="home-sec home-last" id="hizli">
  <div class="wrap">
    <div class="wc-band">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Kategori · Hızlı Tarifler</div>
          <h2>Mesaiden çık, kısa sürede sofrada ol.</h2>
          <p>Tek kap, az bulaşık, ertesi gün ofis kutusuna da giren tarifler.</p>
        </div>
        <a class="clear" href="{{ '/kategori/hizli/' | link }}">Kategoriye git</a>
      </div>
      <div class="wc-grid">
        {% for r in collections.tarifler | inCat('hizli') | sortByMin | take(4) %}
        <a class="wc-card" href="{{ r.url | link }}"><span class="clock">{{ r.data.prep + r.data.cook }}<small>dk</small></span><b>{{ r.data.title }}</b></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{"@context": "https://schema.org", "@graph": [
  {"@type": "WebSite", "@id": "{{ site.url }}/#website", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "inLanguage": "tr", "description": {{ site.description | dump | safe }}, "publisher": {"@id": "{{ site.url }}/#org"}},
  {"@type": "Organization", "@id": "{{ site.url }}/#org", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "logo": "{{ site.url }}/favicon.svg"}
]}
</script>
