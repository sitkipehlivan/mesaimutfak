---
layout: base.njk
isHome: true
---
{%- set wk = weekly if (weekly and weekly.hero) else { hero: home.hero.slug, heroEyebrow: home.hero.eyebrow, picks: [], popular: home.popular } -%}
{%- set heroR = collections.tarifler | bySlug(wk.hero) -%}
{%- if not heroR -%}{%- set heroR = (collections.tarifler | bySlugs(wk.picks))[0] or collections.tarifler[0] -%}{%- endif -%}

{# 1. Haftanın tarifleri: slider, her pazartesi otomatik yenilenir #}
{%- set slides = [heroR] -%}
{%- for r in (collections.tarifler | bySlugs(wk.picks)) -%}{%- if r != heroR and slides.length < 6 -%}{%- set _x = slides.push(r) -%}{%- endif -%}{%- endfor -%}
<h1 class="sr-only">Mesai Mutfak: pratik ve kolay yemek tarifleri</h1>
<div class="wrap hero-solo hero-tools">
  <div class="hslider" id="hslider" aria-roledescription="carousel" aria-label="Haftanın tarifleri">
    <div class="hs-track" tabindex="0">
      {% for r in slides %}
      <a class="feature hs-slide" href="{{ r.url | link }}" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ slides.length }}: {{ r.data.title }}">
        <span class="photo">{% visual { image: r.data.image, heroImage: (home.hero.heroImage if loop.first else ''), imageAlt: r.data.imageAlt, title: r.data.title, art: r.data.art }, 'scene', r.fileSlug, loop.first %}</span>
        <span class="over">
          <span class="eyebrow">{% if loop.first %}{{ wk.heroEyebrow }}{% else %}Haftanın tarifleri · {{ r.data.cats[0] | catLabel(categories) }}{% endif %}</span>
          <span class="h1">{{ r.data.title }}</span>
          <span class="meta"><span>{{ r.data.prep + r.data.cook }} dk</span><span>{{ r.data.serv }} kişilik</span><span>{{ r.data.lvl }}</span></span>
        </span>
      </a>
      {% endfor %}
    </div>
    {% if slides.length > 1 %}
    <button class="hs-btn hs-prev" type="button" aria-label="Önceki tarif">‹</button>
    <button class="hs-btn hs-next" type="button" aria-label="Sonraki tarif">›</button>
    <div class="hs-dots">{% for r in slides %}<button type="button" aria-label="{{ loop.index }}. tarif: {{ r.data.title }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
    {% endif %}
  </div>
  <aside class="htools" aria-label="Mutfak araçları">
    <a class="ht ht-talk" href="{{ '/asistan/' | link }}">
      <span class="ht-ic" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><path class="i-bub" d="M5 10a6 6 0 0 1 6-6h26a6 6 0 0 1 6 6v17a6 6 0 0 1-6 6H22l-8 8v-8h-3a6 6 0 0 1-6-6z" fill="#fff" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><rect x="19.5" y="8.5" width="9" height="14" rx="4.5" fill="#e0335c" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M22.4 11.5v4.5" stroke="#fff" stroke-width="2" stroke-linecap="round"/><path d="M15.5 18a8.5 8.5 0 0 0 17 0M24 26.5v3" fill="none" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path class="i-w1" d="M11.5 12.5a8 8 0 0 0 0 11" fill="none" stroke="#e0335c" stroke-width="2.4" stroke-linecap="round"/><path class="i-w2" d="M36.5 12.5a8 8 0 0 1 0 11" fill="none" stroke="#e0335c" stroke-width="2.4" stroke-linecap="round"/></svg></span>
      <span class="ht-tx"><b>Bizimle konuş</b><em>Evde ne var, kaç dakikan var? Anlat, yemeği biz seçelim</em></span>
    </a>
    <a class="ht ht-foto" href="{{ '/asistan/?foto=1' | link }}">
      <span class="ht-ic" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="5" width="24" height="39" rx="4" fill="#eaf6f0" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M7 19h24M7 31h24" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="13.5" cy="14" r="3.4" fill="#e2483d" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><ellipse cx="22.5" cy="14" rx="2.6" ry="3.3" fill="#fff" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M12 27.5l4.5-6 2 6.5z" fill="#f08a24" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="25" cy="26" r="3.5" fill="#5fb85a" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><rect x="11" y="34" width="5" height="7" rx="1.5" fill="#9fd3f0" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><rect x="19" y="36" width="8" height="5" rx="1.5" fill="#ffd34d" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path class="i-door" d="M31 6.5l10 3.5v30l-10 3.5z" fill="#bfe3d3" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M34.5 20v6" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path class="i-spark" d="M42 1.5l1.2 3.3 3.3 1.2-3.3 1.2-1.2 3.3-1.2-3.3-3.3-1.2 3.3-1.2z" fill="#ffd34d" stroke="#1b1b1b" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
      <span class="ht-tx"><b><span><span class="ht-uzun">Buzdolabının fotoğrafını çek</span><span class="ht-kisa">Buzdolabı fotoğrafı</span></span> <i class="ht-yeni">Yeni</i></b><em>İçindekilere bakalım, ne pişireceğini söyleyelim</em></span>
    </a>
    <a class="ht ht-menu" href="{{ '/haftalik-menu/' | link }}">
      <span class="ht-ic" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="9" width="38" height="34" rx="6" fill="#fff" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M5 15a6 6 0 0 1 6-6h26a6 6 0 0 1 6 6v3H5z" fill="#f2b62b" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M15 5v8M33 5v8" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="14" cy="26" r="3.6" fill="#e2483d" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="24" cy="26" r="3.6" fill="#5fb85a" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="34" cy="26" r="3.6" fill="#f08a24" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="14" cy="35.5" r="3.6" fill="#ffd34d" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><circle cx="24" cy="35.5" r="3.6" fill="#c98a4b" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><g class="i-check"><circle cx="34" cy="35.5" r="4.6" fill="#e0335c" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M31.8 35.6l1.6 1.7 3-3.3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></g></svg></span>
      <span class="ht-tx"><b>Haftalık menü <i class="ht-yeni">Yeni</i></b><em>Haftanın akşam yemekleri ve tek alışveriş listesi</em></span>
    </a>
    <a class="ht ht-zar" href="{{ '/bugun-ne-pisirsem/' | link }}">
      <span class="ht-ic" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><g class="i-q"><path d="M20 8.5a4.5 4.5 0 1 1 6.2 4.2c-1.3.6-2.2 1.6-2.2 3.1" fill="none" stroke="#e0335c" stroke-width="3" stroke-linecap="round"/><circle cx="24" cy="19.6" r="1.7" fill="#e0335c"/></g><g class="i-lid"><path d="M10 25.5c2-5 26-5 28 0z" fill="#f7cf5a" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M21 21.2h6" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/></g><path d="M8.5 26h31v9a8 8 0 0 1-8 8h-15a8 8 0 0 1-8-8z" fill="#f2b62b" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M4 29h4.5M39.5 29H44" stroke="#1b1b1b" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M14 31.5h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".7"/></svg></span>
      <span class="ht-tx"><b>Bugün ne pişirsem?</b><em>Birkaç seçim yap, kararı biz verelim</em></span>
    </a>
  </aside>
</div>
<script>
(function(){var root=document.getElementById('hslider');if(!root)return;var tr=root.querySelector('.hs-track'),sl=tr.children,dots=root.querySelectorAll('.hs-dots button'),n=sl.length;if(n<2)return;
function cur(){return Math.round(tr.scrollLeft/tr.clientWidth)}
function go(i){i=(i+n)%n;tr.scrollTo({left:i*tr.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
root.querySelector('.hs-prev').onclick=function(){go(cur()-1);stop()};root.querySelector('.hs-next').onclick=function(){go(cur()+1);stop()};
dots.forEach(function(d,i){d.onclick=function(){go(i);stop()}});
var raf;tr.addEventListener('scroll',function(){cancelAnimationFrame(raf);raf=requestAnimationFrame(function(){var c=cur();dots.forEach(function(d,i){if(i===c)d.setAttribute('aria-current','true');else d.removeAttribute('aria-current')})})},{passive:true});
tr.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){go(cur()+1);stop()}if(e.key==='ArrowLeft'){go(cur()-1);stop()}});
var t=null,paused=false;function play(){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;clearInterval(t);t=setInterval(function(){if(!paused&&!document.hidden)go(cur()+1)},6000)}function stop(){clearInterval(t);t=null}
root.addEventListener('mouseenter',function(){paused=true});root.addEventListener('mouseleave',function(){paused=false});root.addEventListener('focusin',function(){paused=true});tr.addEventListener('touchstart',stop,{passive:true});
play()})();
</script>

{# Saat (Apple Watch) ana sayfası: yalnızca saat görünümünde gösterilir #}
<section class="w-home" aria-label="Saat görünümü">
  <form class="w-ask" action="{{ '/asistan/' | link }}" method="get">
    <label for="wq">Ne pişirsem?</label>
    <input id="wq" name="q" type="text" placeholder="Söyle ya da yaz" autocomplete="off" enterkeyhint="send">
    <button type="submit" class="w-btn w-pri">Tarif öner</button>
  </form>
  <h2 class="w-h">Haftanın tarifleri</h2>
  <ul class="w-list">
    {% for r in slides %}<li><a href="{{ r.url | link }}">{% if r.data.image %}<img src="{{ r.data.image | imgUrl(120) }}" alt="" width="40" height="40" loading="lazy">{% endif %}<span><b>{{ r.data.title }}</b><em>{{ r.data.prep + r.data.cook }} dk</em></span></a></li>{% endfor %}
  </ul>
  <h2 class="w-h">Hızlı tarifler</h2>
  <ul class="w-list">
    {% for r in collections.tarifler | inCat('hizli') | sortByMin | take(8) %}<li><a href="{{ r.url | link }}">{% if r.data.image %}<img src="{{ r.data.image | imgUrl(120) }}" alt="" width="40" height="40" loading="lazy">{% endif %}<span><b>{{ r.data.title }}</b><em>{{ r.data.prep + r.data.cook }} dk</em></span></a></li>{% endfor %}
  </ul>
  <a class="w-btn" href="{{ '/tarifler/' | link }}">Tüm tarifler</a>
  <a class="w-btn" href="{{ '/kaydettiklerim/' | link }}">Kaydettiklerim</a>
</section>

{# Arama #}
<section class="home-search">
  <div class="wrap">
    <form class="bigsearch" role="search" action="{{ '/ara/' | link }}">
      <label for="homeq" class="sr-only">Tarif ya da malzeme ara</label>
      <input id="homeq" name="q" type="search" placeholder="{{ collections.tarifler.length }} tarif içinde ara: mantı, tavuk, nohut, vegan…" autocomplete="off">
      <button type="submit" class="btn">Ara</button>
      <a class="voice-btn" id="homeVoice" data-voice data-voice-input="homeq" href="{{ '/asistan/' | link }}" aria-label="Sesle tarif sor"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2z"/></svg><span>Sesle sor</span></a>
      <a class="voice-btn foto-btn" href="{{ '/asistan/?foto=1' | link }}" aria-label="Buzdolabının fotoğrafıyla tarif sor"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3 7.17 5H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3.17L15 3H9zm3 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6z"/></svg><span>Fotoğrafla</span></a>
    </form>
    <div class="qchips"><span>Sık arananlar:</span>{% for q in ['mantı', 'köfte', 'börek', 'tavuk', 'çorba', 'kek', 'vegan', 'pilav'] %}<a href="{{ ('/ara/?q=' + q) | link }}">{{ q }}</a>{% endfor %}</div>
  </div>
</section>

{# 2. Kategoriler #}
<section class="home-sec" id="kategoriler">
  <div class="wrap">
    <div class="home-head">
      <h2>Kategoriler</h2>
      <a class="tool-btn" href="{{ '/bugun-ne-pisirsem/' | link }}">Bugün ne pişirsem? <span aria-hidden="true">→</span></a>
    </div>
    <div class="cats cats-sm">
      {% for c in categories.types %}
      <a class="cat" href="{{ ('/kategori/' + c.k + '/') | link }}">{% set ci = c.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="background:{{ c.k | tint }}">{% if ci %}<img src="{{ ci.src }}" srcset="{{ ci.src }} 1x, {{ ci.src2 }} 2x" alt="" width="160" height="160" loading="lazy" decoding="async">{% else %}{% plateArt c.art, c.k %}{% endif %}</span><b>{{ c.l }}</b></a>
      {% endfor %}
    </div>
  </div>
</section>

{# Ana sayfa masthead: kategoriler ile Sana göre arasında #}
<div class="wrap ad-row">{% set slot = 'masthead' %}{% include "ad.njk" %}</div>

{# 3. Sana göre #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Sana göre</h2><span class="home-sub">Beslenme tercihi, vakit ve mevsim</span></div>
    <div class="diet">
      {% for k in homeDiets %}{% set c = k | catByKey(allcats) %}
      <a class="dcard{% if c.wc %} wc{% endif %}" href="{{ ('/kategori/' + c.k + '/') | link }}">{% set ci = c.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="{% if not c.wc %}background:{{ c.k | tint }}{% endif %}">{% if ci %}<img src="{{ ci.src }}" srcset="{{ ci.src }} 1x, {{ ci.src2 }} 2x" alt="" width="160" height="160" loading="lazy" decoding="async">{% else %}{% plateArt c.art, c.k %}{% endif %}</span><span><b>{{ c.l }}</b><span>{{ c.s }}</span><em>{{ (collections.tarifler | inCat(c.k)).length }} tarif</em></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 4. En çok bakılanlar #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Bu hafta en çok bakılanlar</h2><a class="home-more" href="{{ '/tarifler/' | link }}">Tüm tarifler →</a></div>
    <div class="pop-row">
      {% for r in collections.tarifler | bySlugs(wk.popular) %}
      <a class="pop-item" href="{{ r.url | link }}"><span class="th" style="background:{{ r.fileSlug | tint }}">{% visual r.data, 'plate', r.fileSlug %}</span><span><b><span class="n">{{ loop.index }}</span>{{ r.data.title }}</b><span>{{ r.data.prep + r.data.cook }} dk · {{ r.data.lvl }}</span></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 5. Bugün ne pişirsem? #}
<section class="home-sec">
  <div class="wrap">
    <div class="picker-promo">
      <div>
        <div class="eyebrow">Karar veremeyenlere</div>
        <h2>Bugün ne pişirsem?</h2>
        <p>Ruh halini seç, sana uygun tarifi bulalım. Tür, zorluk ve süreyi de ayarlayabilirsin.</p>
        <a class="talk-btn" href="{{ '/asistan/' | link }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2z"/></svg><span><b>Bizimle konuş</b><em>Anlat, yemeği biz seçelim</em></span></a>
      </div>
      <div class="mood-links">
        {% for m in moods %}<a href="{{ ('/bugun-ne-pisirsem/#' + m.k) | link }}"><b>{{ m.l }}</b><span>{{ m.s }}</span></a>{% endfor %}
      </div>
    </div>
  </div>
</section>
<div class="wrap ad-row">{% set slot = 'leader' %}{% include "ad.njk" %}</div>

{# 6. Hızlı tarifler #}
<section class="home-sec home-last" id="hizli">
  <div class="wrap">
    <div class="wc-band">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Kategori · Hızlı Tarifler</div>
          <h2>Mesaiden çık, kısa sürede sofrada ol.</h2>
          <p>Tek kap, az bulaşık, ertesi gün ofis kutusuna da giren tarifler.</p>
        </div>
        <a class="clear" href="{{ '/kategori/hizli/' | link }}">Kategoriye git</a>
      </div>
      <div class="wc-grid">
        {% for r in collections.tarifler | inCat('hizli') | sortByMin | take(4) %}
        <a class="wc-card" href="{{ r.url | link }}"><span class="clock">{{ r.data.prep + r.data.cook }}<small>dk</small></span><b>{{ r.data.title }}</b></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{"@context": "https://schema.org", "@graph": [
  {"@type": "WebSite", "@id": "{{ site.url }}/#website", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "inLanguage": "tr", "description": {{ site.description | dump | safe }}, "publisher": {"@id": "{{ site.url }}/#org"},
   "potentialAction": {"@type": "SearchAction", "target": {"@type": "EntryPoint", "urlTemplate": "{{ site.url }}/ara/?q={search_term_string}"}, "query-input": "required name=search_term_string"}},
  {"@type": "Organization", "@id": "{{ site.url }}/#org", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "logo": "{{ site.url }}/favicon.svg"}
]}
</script>
