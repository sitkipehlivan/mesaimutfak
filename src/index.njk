---
layout: base.njk
isHome: true
---
{%- set wk = weekly if (weekly and weekly.hero) else { hero: home.hero.slug, heroEyebrow: home.hero.eyebrow, picks: [], popular: home.popular } -%}
{%- set heroR = collections.tarifler | bySlug(wk.hero) -%}

{# 1. Haftanın tarifleri: slider, her pazartesi otomatik yenilenir #}
{%- set slides = [heroR] -%}
{%- for r in (collections.tarifler | bySlugs(wk.picks)) -%}{%- if loop.index <= 5 -%}{%- set _x = slides.push(r) -%}{%- endif -%}{%- endfor -%}
<div class="wrap hero-solo hero-ad">
  <div class="hslider" id="hslider" aria-roledescription="carousel" aria-label="Haftanın tarifleri">
    <div class="hs-track" tabindex="0">
      {% for r in slides %}
      <a class="feature hs-slide" href="{{ r.url | link }}" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ slides.length }}: {{ r.data.title }}">
        <span class="photo">{% visual { image: r.data.image, heroImage: (home.hero.heroImage if loop.first else ''), imageAlt: r.data.imageAlt, title: r.data.title, art: r.data.art }, 'scene', r.fileSlug, loop.first %}</span>
        <span class="over">
          <span class="eyebrow">{% if loop.first %}{{ wk.heroEyebrow }}{% else %}Haftanın tarifleri · {{ r.data.cats[0] | catLabel(categories) }}{% endif %}</span>
          {% if loop.first %}<h1>{{ r.data.title }}</h1>{% else %}<span class="h1">{{ r.data.title }}</span>{% endif %}
          <span class="meta"><span>{{ r.data.prep + r.data.cook }} dk</span><span>{{ r.data.serv }} kişilik</span><span>{{ r.data.lvl }}</span></span>
        </span>
      </a>
      {% endfor %}
    </div>
    {% if slides.length > 1 %}
    <button class="hs-btn hs-prev" type="button" aria-label="Önceki tarif">‹</button>
    <button class="hs-btn hs-next" type="button" aria-label="Sonraki tarif">›</button>
    <div class="hs-dots">{% for r in slides %}<button type="button" aria-label="{{ loop.index }}. tarif: {{ r.data.title }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
    {% endif %}
  </div>
  {% set slot = 'atf' %}{% include "ad.njk" %}
</div>
<script>
(function(){var root=document.getElementById('hslider');if(!root)return;var tr=root.querySelector('.hs-track'),sl=tr.children,dots=root.querySelectorAll('.hs-dots button'),n=sl.length;if(n<2)return;
function cur(){return Math.round(tr.scrollLeft/tr.clientWidth)}
function go(i){i=(i+n)%n;tr.scrollTo({left:i*tr.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
root.querySelector('.hs-prev').onclick=function(){go(cur()-1);stop()};root.querySelector('.hs-next').onclick=function(){go(cur()+1);stop()};
dots.forEach(function(d,i){d.onclick=function(){go(i);stop()}});
var raf;tr.addEventListener('scroll',function(){cancelAnimationFrame(raf);raf=requestAnimationFrame(function(){var c=cur();dots.forEach(function(d,i){if(i===c)d.setAttribute('aria-current','true');else d.removeAttribute('aria-current')})})},{passive:true});
tr.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){go(cur()+1);stop()}if(e.key==='ArrowLeft'){go(cur()-1);stop()}});
var t=null,paused=false;function play(){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;clearInterval(t);t=setInterval(function(){if(!paused&&!document.hidden)go(cur()+1)},6000)}function stop(){clearInterval(t);t=null}
root.addEventListener('mouseenter',function(){paused=true});root.addEventListener('mouseleave',function(){paused=false});root.addEventListener('focusin',function(){paused=true});tr.addEventListener('touchstart',stop,{passive:true});
play()})();
</script>

{# Arama #}
<section class="home-search">
  <div class="wrap">
    <form class="bigsearch" role="search" action="{{ '/ara/' | link }}">
      <label for="homeq" class="sr-only">Tarif ya da malzeme ara</label>
      <input id="homeq" name="q" type="search" placeholder="{{ collections.tarifler.length }} tarif içinde ara: mantı, tavuk, nohut, vegan…" autocomplete="off">
      <button type="submit" class="btn">Ara</button>
    </form>
    <div class="qchips"><span>Sık arananlar:</span>{% for q in ['mantı', 'köfte', 'börek', 'tavuk', 'çorba', 'kek', 'vegan', 'pilav'] %}<a href="{{ ('/ara/?q=' + q) | link }}">{{ q }}</a>{% endfor %}</div>
  </div>
</section>

{# 2. Kategoriler #}
<section class="home-sec" id="kategoriler">
  <div class="wrap">
    <div class="home-head">
      <h2>Kategoriler</h2>
      <a class="tool-btn" href="{{ '/bugun-ne-pisirsem/' | link }}">Bugün ne pişirsem? <span aria-hidden="true">→</span></a>
    </div>
    <div class="cats cats-sm">
      {% for c in categories.types %}
      <a class="cat" href="{{ ('/kategori/' + c.k + '/') | link }}">{% set ci = c.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="background:{{ c.k | tint }}">{% if ci %}<img src="{{ ci.src }}" srcset="{{ ci.src }} 1x, {{ ci.src2 }} 2x" alt="" width="160" height="160" loading="lazy" decoding="async">{% else %}{% plateArt c.art, c.k %}{% endif %}</span><b>{{ c.l }}</b></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 3. Sana göre #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Sana göre</h2><span class="home-sub">Beslenme tercihi, vakit ve mevsim</span></div>
    <div class="diet">
      {% for k in homeDiets %}{% set c = k | catByKey(allcats) %}
      <a class="dcard{% if c.wc %} wc{% endif %}" href="{{ ('/kategori/' + c.k + '/') | link }}">{% set ci = c.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="{% if not c.wc %}background:{{ c.k | tint }}{% endif %}">{% if ci %}<img src="{{ ci.src }}" srcset="{{ ci.src }} 1x, {{ ci.src2 }} 2x" alt="" width="160" height="160" loading="lazy" decoding="async">{% else %}{% plateArt c.art, c.k %}{% endif %}</span><span><b>{{ c.l }}</b><span>{{ c.s }}</span><em>{{ (collections.tarifler | inCat(c.k)).length }} tarif</em></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 4. En çok bakılanlar #}
<section class="home-sec">
  <div class="wrap">
    <div class="home-head"><h2>Bu hafta en çok bakılanlar</h2><a class="home-more" href="{{ '/tarifler/' | link }}">Tüm tarifler →</a></div>
    <div class="pop-row">
      {% for r in collections.tarifler | bySlugs(wk.popular) %}
      <a class="pop-item" href="{{ r.url | link }}"><span class="th" style="background:{{ r.fileSlug | tint }}">{% visual r.data, 'plate', r.fileSlug %}</span><span><b><span class="n">{{ loop.index }}</span>{{ r.data.title }}</b><span>{{ r.data.prep + r.data.cook }} dk · {{ r.data.lvl }}</span></span></a>
      {% endfor %}
    </div>
  </div>
</section>

{# 5. Bugün ne pişirsem? #}
<section class="home-sec">
  <div class="wrap">
    <div class="picker-promo">
      <div>
        <div class="eyebrow">Karar veremeyenlere</div>
        <h2>Bugün ne pişirsem?</h2>
        <p>Ruh halini seç, sana uygun tarifi bulalım. Tür, zorluk ve süreyi de ayarlayabilirsin.</p>
      </div>
      <div class="mood-links">
        {% for m in moods %}<a href="{{ ('/bugun-ne-pisirsem/#' + m.k) | link }}"><b>{{ m.l }}</b><span>{{ m.s }}</span></a>{% endfor %}
      </div>
    </div>
  </div>
</section>

{# 6. Hızlı tarifler #}
<section class="home-sec home-last" id="hizli">
  <div class="wrap">
    <div class="wc-band">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Kategori · Hızlı Tarifler</div>
          <h2>Mesaiden çık, kısa sürede sofrada ol.</h2>
          <p>Tek kap, az bulaşık, ertesi gün ofis kutusuna da giren tarifler.</p>
        </div>
        <a class="clear" href="{{ '/kategori/hizli/' | link }}">Kategoriye git</a>
      </div>
      <div class="wc-grid">
        {% for r in collections.tarifler | inCat('hizli') | sortByMin | take(4) %}
        <a class="wc-card" href="{{ r.url | link }}"><span class="clock">{{ r.data.prep + r.data.cook }}<small>dk</small></span><b>{{ r.data.title }}</b></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{"@context": "https://schema.org", "@graph": [
  {"@type": "WebSite", "@id": "{{ site.url }}/#website", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "inLanguage": "tr", "description": {{ site.description | dump | safe }}, "publisher": {"@id": "{{ site.url }}/#org"},
   "potentialAction": {"@type": "SearchAction", "target": {"@type": "EntryPoint", "urlTemplate": "{{ site.url }}/ara/?q={search_term_string}"}, "query-input": "required name=search_term_string"}},
  {"@type": "Organization", "@id": "{{ site.url }}/#org", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/", "logo": "{{ site.url }}/favicon.svg"}
]}
</script>
