---
layout: base.njk
pagination:
  data: allcats
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: "/kategori/{{ cat.k }}/"
eleventyComputed:
  title: "{{ cat.l }}"
  seoTitle: "{% if cat.seoFull %}{{ cat.seoFull }}{% else %}{{ cat.seoTitle }}: Pratik ve kolay tarifler{% endif %}"
  desc: "{{ cat.intro }}"
---
{%- set list = collections.tarifler | inCat(cat.k) | photoFirst -%}
<div class="wrap">
  <nav class="crumbs" aria-label="Konum"><a href="{{ '/' | link }}">Ana sayfa</a><span>/</span><a href="{{ '/#kategoriler' | link }}">Kategoriler</a><span>/</span><span aria-current="page">{{ cat.l }}</span></nav>
  <header class="cat-hero{% if cat.wc %} wc{% endif %}">
    {% set ci = cat.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="{% if not cat.wc %}background:{{ cat.k | tint }}{% endif %}">{% if ci %}<img src="{{ ci.src2 }}" alt="" width="160" height="160" decoding="async">{% else %}{% plateArt cat.art, cat.k %}{% endif %}</span>
    <div>
      <div class="eyebrow">Kategori · {{ list.length }} tarif</div>
      <h1>{{ cat.l }}</h1>
      <p>{{ cat.intro }}</p>
    </div>
  </header>
  <div class="grid" style="margin-block:28px 64px">
    {% for r in list %}{% include "card.njk" %}{% if loop.index % 5 == 0 and not loop.last %}<div class="grid-ad grid-ad-feed">{% set slot = 'infeed' %}{% include "ad.njk" %}</div>{% endif %}{% else %}<div class="empty">Bu kategoride henüz tarif yok.</div>{% endfor %}
  </div>
  {% if cat.k == 'airfryer' %}{% set R = airfryerRehber %}
  <section class="af-hub" aria-labelledby="afTablo">
    <h2 id="afTablo">{{ R.baslik }}</h2>
    <p>{{ R.aciklama }}</p>
    <div class="af-table-wrap"><table class="af-table">
      <thead><tr><th scope="col">Yiyecek</th><th scope="col">Derece</th><th scope="col">Süre</th></tr></thead>
      <tbody>{% for row in R.tablo %}<tr><th scope="row"><a href="{{ ('/tarif/' + row[3] + '/') | link }}">{{ row[0] }}</a></th><td>{{ row[1] }}</td><td>{{ row[2] }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% set klasik = collections.tarifler | airfryerNotlu %}
    {% if klasik.length %}
    <h2>Klasik tarifleri airfryer’da yap</h2>
    <p>Bu tariflerin sayfasında “Airfryer’da nasıl yapılır?” bölümünde derece ve süreyi bulabilirsin.</p>
    <ul class="af-klasik">{% for r in klasik %}<li><a href="{{ (r.url + '#airfryer') | link }}">{{ r.data.title }}</a></li>{% endfor %}</ul>
    {% endif %}
    <section class="faq" aria-labelledby="afSss">
      <h2 id="afSss">Airfryer hakkında sık sorulanlar</h2>
      {% for x in R.sss %}<details{% if loop.first %} open{% endif %}><summary>{{ x.q }}</summary><p>{{ x.a }}</p></details>{% endfor %}
    </section>
  </section>
  {% endif %}
</div>

<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "CollectionPage", "name": {{ cat.seoTitle | dump | safe }}, "description": {{ cat.intro | dump | safe }}, "url": "{{ site.url }}{{ page.url }}",
 "mainEntity": {"@type": "ItemList", "itemListElement": [{% for r in list %}{"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ site.url }}{{ r.url }}", "name": {{ r.data.title | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]},
 "breadcrumb": {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Ana sayfa", "item": "{{ site.url }}/"}, {"@type": "ListItem", "position": 2, "name": {{ cat.l | dump | safe }}, "item": "{{ site.url }}{{ page.url }}"}]}}
</script>
{% if cat.k == 'airfryer' %}<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{% for x in airfryerRehber.sss %}{"@type": "Question", "name": {{ x.q | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ x.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>{% endif %}
