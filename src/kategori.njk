---
layout: base.njk
pagination:
  data: allcats
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: "/kategori/{{ cat.k }}/"
eleventyComputed:
  title: "{{ cat.l }}"
  seoTitle: "{{ cat.seoTitle }}: Pratik ve kolay tarifler"
  desc: "{{ cat.intro }}"
---
{%- set list = collections.tarifler | inCat(cat.k) | photoFirst -%}
<div class="wrap">
  <nav class="crumbs" aria-label="Konum"><a href="{{ '/' | link }}">Ana sayfa</a><span>/</span><a href="{{ '/#kategoriler' | link }}">Kategoriler</a><span>/</span><span aria-current="page">{{ cat.l }}</span></nav>
  <header class="cat-hero{% if cat.wc %} wc{% endif %}">
    {% set ci = cat.k | catImg(catthumbs, collections.tarifler) %}<span class="ic{% if ci %} has-img{% endif %}" style="{% if not cat.wc %}background:{{ cat.k | tint }}{% endif %}">{% if ci %}<img src="{{ ci.src2 }}" alt="" width="160" height="160" decoding="async">{% else %}{% plateArt cat.art, cat.k %}{% endif %}</span>
    <div>
      <div class="eyebrow">Kategori · {{ list.length }} tarif</div>
      <h1>{{ cat.l }}</h1>
      <p>{{ cat.intro }}</p>
    </div>
  </header>
  <div class="grid" style="margin-block:28px 64px">
    {% for r in list %}{% include "card.njk" %}{% if loop.index == 6 or (loop.last and loop.length < 6) %}<div class="grid-ad">{% set slot = 'incontent' %}{% include "ad.njk" %}</div>{% endif %}{% else %}<div class="empty">Bu kategoride henüz tarif yok.</div>{% endfor %}
  </div>
</div>

<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "CollectionPage", "name": {{ cat.seoTitle | dump | safe }}, "description": {{ cat.intro | dump | safe }}, "url": "{{ site.url }}{{ page.url }}",
 "mainEntity": {"@type": "ItemList", "itemListElement": [{% for r in list %}{"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ site.url }}{{ r.url }}", "name": {{ r.data.title | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]},
 "breadcrumb": {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Ana sayfa", "item": "{{ site.url }}/"}, {"@type": "ListItem", "position": 2, "name": {{ cat.l | dump | safe }}, "item": "{{ site.url }}{{ page.url }}"}]}}
</script>
