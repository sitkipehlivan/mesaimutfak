/* Mesai Mutfak service worker · sürüm {{ build.time }} */
const V = '{{ build.time }}';
const SHELL = 'mm-shell-' + V, PAGES = 'mm-pages', IMGS = 'mm-imgs', SAVED = 'mm-saved', FONTS = 'mm-fonts';
const PRECACHE = ['/', '/offline/', '/listem/', '/kaydettiklerim/', '/bugun-ne-pisirsem/', '/assets/style.css', '/assets/site.js', '/assets/ads.js', '/favicon.svg', '/img/app/icon-192.png', '/manifest.webmanifest'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(SHELL).then(c => c.addAll(PRECACHE)).then(() => self.skipWaiting()));
});
self.addEventListener('activate', e => {
  e.waitUntil(caches.keys().then(ks => Promise.all(ks.filter(k => k.startsWith('mm-shell-') && k !== SHELL).map(k => caches.delete(k)))).then(() => self.clients.claim()));
});

async function trim(name, max) {
  const c = await caches.open(name), ks = await c.keys();
  for (let i = 0; i < ks.length - max; i++) await c.delete(ks[i]);
}
async function put(name, req, res, max) {
  if (!res || !res.ok || res.type === 'opaqueredirect') return;
  const c = await caches.open(name); await c.put(req, res); if (max) trim(name, max);
}

self.addEventListener('fetch', e => {
  const req = e.request, url = new URL(req.url);
  if (req.method !== 'GET') return;
  // Google Fonts: önce önbellek
  if (url.hostname === 'fonts.googleapis.com' || url.hostname === 'fonts.gstatic.com') {
    e.respondWith(caches.match(req).then(r => r || fetch(req).then(res => { put(FONTS, req, res.clone()); return res; })));
    return;
  }
  if (url.origin !== location.origin) return;           // reklam, analiz vb. dokunma
  if (url.pathname.startsWith('/admin') || url.pathname === '/sw.js') return;

  // sayfalar: önce ağ, olmazsa önbellek, o da yoksa çevrimdışı sayfası
  if (req.mode === 'navigate') {
    e.respondWith((async () => {
      try {
        const res = await fetch(req);
        put(PAGES, stripQuery(req), res.clone(), 80);
        return res;
      } catch (err) {
        return (await caches.match(stripQuery(req), { ignoreSearch: true })) || (await caches.match('/offline/'));
      }
    })());
    return;
  }
  // görseller: önce önbellek
  if (url.pathname.startsWith('/.netlify/images') || url.pathname.startsWith('/img/')) {
    e.respondWith(caches.match(req).then(r => r || fetch(req).then(res => { put(IMGS, req, res.clone(), 250); return res; }).catch(() => new Response('', { status: 504 }))));
    return;
  }
  // css, js, json: önbellekten hemen ver, arkada tazele
  // css/js sürüm numaralı (?v=): aynı sürüm önbellekten, yeni sürüm ağdan; çevrimdışıysa eldeki son sürüm
  e.respondWith(caches.match(req).then(r => {
    if (r) return r;
    return fetch(req).then(res => { if (res.ok && (url.pathname.startsWith('/assets/') || url.pathname.endsWith('.json'))) put(SHELL, req, res.clone()); return res; })
      .catch(() => caches.match(req, { ignoreSearch: true }));
  }));
});

function stripQuery(req) { const u = new URL(req.url); u.search = ''; return new Request(u.toString()); }

// Kaydedilen tarifleri kalıcı önbelleğe al / çıkar
self.addEventListener('message', e => {
  const d = e.data || {};
  if (d.type === 'save' && d.urls) e.waitUntil(caches.open(SAVED).then(c => Promise.all(d.urls.map(u => fetch(u).then(r => r.ok && c.put(u, r)).catch(() => {})))));
  if (d.type === 'unsave' && d.urls) e.waitUntil(caches.open(SAVED).then(c => Promise.all(d.urls.map(u => c.delete(u)))));
});

// ---------- bildirimler (web push) ----------
const pushOlay = (e, id) => id ? fetch('/api/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ a: 'olay', e, id }) }).catch(() => {}) : Promise.resolve();
self.addEventListener('push', (e) => {
  let d = {};
  try { d = e.data ? e.data.json() : {}; } catch (err) {}
  const secenek = { body: d.b || '', icon: d.i || '/img/app/icon-192.png', badge: '/img/app/icon-192.png', data: { u: d.u || '/', id: d.id || '' } };
  if (d.g) secenek.image = d.g;
  if (d.id) secenek.tag = d.id;
  e.waitUntil(Promise.all([self.registration.showNotification(d.t || 'Mesai Mutfak', secenek), pushOlay('g', d.id)]));
});
self.addEventListener('notificationclick', (e) => {
  const d = e.notification.data || {};
  e.notification.close();
  e.waitUntil(Promise.all([pushOlay('c', d.id), self.clients.openWindow(d.u || '/')]));
});
// Tarayıcı aboneliği yenilerse yeni adresi kaydet, eskisini sil
self.addEventListener('pushsubscriptionchange', (e) => {
  const eski = e.oldSubscription;
  if (!eski || !eski.options) return;
  e.waitUntil(self.registration.pushManager.subscribe(eski.options).then((yeni) => Promise.all([
    fetch('/api/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ a: 'abone', sub: yeni.toJSON() }) }),
    fetch('/api/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ a: 'iptal', endpoint: eski.endpoint }) }),
  ])).catch(() => {}));
});
