---
layout: base.njk
permalink: /bugun-ne-pisirsem/
title: Bugün ne pişirsem?
desc: Ruh haline, vaktine ve canının çektiğine göre sana bir tarif önerelim.
---
<div class="wrap">
  <nav class="crumbs" aria-label="Konum"><a href="{{ '/' | link }}">Ana sayfa</a><span>/</span><span aria-current="page">Bugün ne pişirsem?</span></nav>

  <header class="picker-hero">
    <div class="eyebrow">Karar veremeyenlere</div>
    <h1>Bugün ne pişirsem?</h1>
    <p>Birkaç seçim yap, mutfaktaki kararı biz verelim. Hiçbirini seçmesen de olur.</p>
  </header>

  <div class="picker">
    <form class="pk-form" id="pkForm" novalidate>
      <fieldset class="pk-q">
        <legend><span class="mono">1</span> Ruh halin nasıl?</legend>
        <div class="mood-grid">
          {% for m in moods %}
          <label class="mood"><input type="radio" name="mood" value="{{ m.k }}" id="mood-{{ m.k }}"><span><b>{{ m.l }}</b><em>{{ m.s }}</em></span></label>
          {% endfor %}
        </div>
      </fieldset>
      <fieldset class="pk-q">
        <legend><span class="mono">2</span> Ne tür bir şey?</legend>
        <div class="opt-row">
          {% set types = [['', 'Fark etmez'], ['ana', 'Ana yemek'], ['aperatif', 'Aperatif & ara sıcak'], ['corba', 'Çorba'], ['yanina', 'Yanına pilav, zeytinyağlı'], ['kahvalti', 'Kahvaltılık'], ['tatli', 'Tatlı']] %}
          {% for t in types %}<label class="opt"><input type="radio" name="type" value="{{ t[0] }}" id="type-{{ t[0] or 'any' }}"{% if not t[0] %} checked{% endif %}><span>{{ t[1] }}</span></label>{% endfor %}
        </div>
      </fieldset>
      <fieldset class="pk-q">
        <legend><span class="mono">3</span> Zorluk</legend>
        <div class="opt-row">
          {% for l in [['', 'Fark etmez'], ['Kolay', 'Kolay'], ['Orta', 'Orta'], ['Zor', 'Zor']] %}<label class="opt"><input type="radio" name="lvl" value="{{ l[0] }}" id="lvl-{{ l[0] or 'any' }}"{% if not l[0] %} checked{% endif %}><span>{{ l[1] }}</span></label>{% endfor %}
        </div>
      </fieldset>
      <fieldset class="pk-q">
        <legend><span class="mono">4</span> Ne kadar vaktin var?</legend>
        <div class="opt-row">
          {% for l in [['', 'Fark etmez'], ['30', '30 dk ve altı'], ['60', '1 saat'], ['999', 'Bütün akşam']] %}<label class="opt"><input type="radio" name="time" value="{{ l[0] }}" id="time-{{ l[0] or 'any' }}"{% if not l[0] %} checked{% endif %}><span>{{ l[1] }}</span></label>{% endfor %}
        </div>
      </fieldset>
      <fieldset class="pk-q">
        <legend><span class="mono">5</span> Beslenme tercihi</legend>
        <div class="opt-row">
          <label class="opt"><input type="checkbox" name="vegan" id="diet-vegan"><span>Vegan</span></label>
          <label class="opt"><input type="checkbox" name="glutensiz" id="diet-glutensiz"><span>Glutensiz</span></label>
        </div>
      </fieldset>
      <div class="pk-submit">
        <button type="submit" class="btn">Bana bir tarif öner</button>
        <button type="reset" class="btn ghost" id="pkReset">Seçimleri temizle</button>
      </div>
    </form>

    <section class="pk-result" aria-live="polite">
      <p class="pk-msg" id="pkMsg">Seçim yapmadan bile bir önerimiz var:</p>
      <div id="pkMain"></div>
      <div class="pk-more">
        <button type="button" class="btn" id="pkNext">Başka öner</button>
        <span class="mono" id="pkCount"></span>
      </div>
      <div class="pk-alt-head eyebrow">Bunlar da olabilir</div>
      <div class="pk-alts" id="pkAlts"></div>
    </section>
  </div>
</div>

{# Her tarif için önceden hazırlanmış kartlar; öneri motoru bunlardan seçer #}
<div hidden id="pkPool">
  {% for r in collections.tarifler %}
  <a class="pk-card" href="{{ r.url | link }}" data-slug="{{ r.fileSlug }}" data-cats="{{ r.data.cats | join(' ') }}" data-lvl="{{ r.data.lvl }}" data-min="{{ r.data.prep + r.data.cook }}" data-moods="{{ r.data.moods | join(' ') }}">
    <span class="pk-art" style="background:{{ r.fileSlug | tint }}">{% visual r.data, 'plate', r.fileSlug %}</span>
    <span class="pk-txt">
      <span class="cat-name">{{ r.data.cats[0] | catLabel(categories) }}</span>
      <b>{{ r.data.title }}</b>
      <span class="pk-desc">{{ r.data.desc }}</span>
      <span class="pk-facts mono">{{ r.data.prep + r.data.cook }} dk · {{ r.data.lvl }} · {{ r.data.serv }} kişilik</span>
      <span class="pk-go">Tarife git →</span>
    </span>
  </a>
  {% endfor %}
</div>
<script type="application/json" id="pkMoods">{{ moods | dump | safe }}</script>
