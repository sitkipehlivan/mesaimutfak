{%- set d = r.data -%}
<a class="rc" href="{{ r.url | link }}">
  <div class="art{% if d.image %} has-photo{% endif %}" style="background:{{ r.fileSlug | tint }}">
    {% visual d, 'plate', r.fileSlug %}
    <div class="badges">{% if d.youtube %}<span class="badge vid">▶ Video</span>{% endif %}{% if 'hizli' in d.cats %}<span class="badge wc">Hızlı</span>{% endif %}</div>
  </div>
  <div class="body">
    <span class="cat-name">{{ d.cats[0] | catLabel(categories) }}</span>
    <h3>{{ d.title }}</h3>
    <p>{{ d.desc }}</p>
    {% if 'vegan' in d.cats or 'glutensiz' in d.cats %}<div class="diet-tags">{% if 'vegan' in d.cats %}<span class="dt v">Vegan</span>{% endif %}{% if 'glutensiz' in d.cats %}<span class="dt g">Glutensiz</span>{% endif %}</div>{% endif %}
    <dl class="facts"><div><dt>Süre</dt><dd>{{ d.prep + d.cook }} dk</dd></div><div><dt>Porsiyon</dt><dd>{{ d.serv }} kişi</dd></div><div><dt>Zorluk</dt><dd>{{ d.lvl }}</dd></div></dl>
  </div>
</a>
