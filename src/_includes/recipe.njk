---
layout: base.njk
---
{%- set me = collections.tarifler | bySlug(page.fileSlug) -%}
{%- set catKey = cats[0] -%}
<div class="wrap">
  <nav class="crumbs" aria-label="Konum">
    <a href="{{ '/' | link }}">Ana sayfa</a><span>/</span><a href="{{ ('/kategori/' + catKey + '/') | link }}">{{ catKey | catLabel(categories) }}</a><span>/</span><span aria-current="page">{{ title }}</span>
  </nav>

  <article class="recipe">
    <header class="r-hero">
      <div class="r-photo{% if image %} has-photo{% endif %}" style="background:{{ page.fileSlug | tint }}">
        {% visual { image: image, imageAlt: imageAlt, title: title, art: art }, 'scene', page.fileSlug, true %}
        {% if not image %}<span class="ph-tag">Fotoğraf alanı</span>{% endif %}
        {% if imageCredit %}<a class="credit" href="{{ imageCreditUrl or '#' }}" target="_blank" rel="noopener">Fotoğraf: {{ imageCredit }}</a>{% endif %}
      </div>
      <div class="r-info">
        <div class="r-cats">
          {% for c in cats %}<a class="r-cat{% if c == 'hizli' %} wc{% endif %}" href="{{ ('/kategori/' + c + '/') | link }}">{{ c | catLabel(categories) }}</a>{% endfor %}
        </div>
        <h1>{{ title }}</h1>
        <p class="r-desc">{{ desc }}</p>
        {%- set au = author | person(authors) -%}{%- set ed = editor | person(authors) -%}
        {% if au or ed or sponsor %}<p class="byline">{% if au %}<span>Tarif: <a href="{{ ('/yazar/' + au.slug + '/') | link }}" rel="author">{{ au.name }}</a></span>{% endif %}{% if ed %}<span>Editör kontrolü: <a href="{{ ('/yazar/' + ed.slug + '/') | link }}">{{ ed.name }}</a></span>{% endif %}{% if updated %}<span>Güncellendi: {{ updated }}</span>{% endif %}{% if sponsor %}<span><b>Sponsorlu</b> · {{ sponsor }}</span>{% endif %}</p>{% endif %}
        <dl class="r-facts">
          <div><dt>Hazırlık</dt><dd>{{ prep }} dk</dd></div>
          <div><dt>Pişirme</dt><dd>{% if cook %}{{ cook }} dk{% else %}Ocak yok{% endif %}</dd></div>
          <div><dt>Toplam</dt><dd>{{ prep + cook }} dk</dd></div>
          <div><dt>Zorluk</dt><dd><span class="lvl lvl-{{ lvl | lower }}"><i></i><i></i><i></i></span>{{ lvl }}</dd></div>
        </dl>
        <div class="r-actions">
          <a class="btn" href="#malzemeler">Malzemeler</a>
          <button type="button" class="btn ghost fav-btn" id="favBtn" data-slug="{{ page.fileSlug }}" data-title="{{ title }}" data-url="{{ page.url }}" data-img="{{ (image | imgUrl(600)) if image else '' }}" data-meta="{{ prep + cook }} dk · {{ serv }} kişilik · {{ lvl }}" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>Kaydet</span></button>
          <button type="button" class="btn ghost" id="cookBtn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"/><path d="M3 11h18M9 7c0-1 1-1 1-2M14 7c0-1 1-1 1-2"/></svg>Pişirme modu</button>
          {% if youtube or videoUrl %}<a class="btn ghost" href="#video">Videoyu izle</a>{% endif %}
        </div>
      </div>
    </header>

    <div class="r-body">
      <div class="r-side">
      <aside class="ingredients" id="malzemeler" data-base="{{ serv }}">
        <div class="ing-head">
          <h2>Malzemeler</h2>
          <div class="servings" role="group" aria-label="Porsiyon">
            <button type="button" class="srv-btn" data-d="-1" aria-label="Porsiyonu azalt">−</button>
            <output class="mono" id="srvOut">{{ serv }} kişilik</output>
            <button type="button" class="srv-btn" data-d="1" aria-label="Porsiyonu artır">+</button>
          </div>
        </div>
        {% for grp in ingredients %}
          {% if grp.group %}<h3 class="ing-group">{{ grp.group }}</h3>{% endif %}
          <ul class="ing-list">
            {% for it in grp.items %}
            <li{% if it.n | isPantry %} data-pantry="1"{% endif %}><label><input type="checkbox" class="have" aria-label="Evde var: {{ it.n }}"><span class="amt mono" data-a="{{ it.a }}">{{ it.a | amt }}</span> <span class="unit">{{ it.u }}</span> <span class="nm">{{ it.n }}</span></label></li>
            {% endfor %}
          </ul>
        {% endfor %}
        <p class="ing-note">Evde olanları işaretle, kalanlar alışveriş listene girer.</p>
        <div class="shop" id="shop" data-slug="{{ page.fileSlug }}" data-title="{{ title }}" data-url="{{ site.url }}{{ page.url }}">
          <div class="shop-head"><b>Eksik malzemeler</b><span class="mono" id="shopCount"></span></div>
          <ul class="shop-list" id="shopList"></ul>
          <div class="shop-actions">
            <button type="button" class="btn" id="shopCopy">Listeyi kopyala</button>
            <a class="btn ghost" id="shopWa" href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a>
            <button type="button" class="btn ghost" id="shopAdd">Listeme ekle</button>
          </div>
          {%- set activePartners = site.partners | selectattr('enabled') -%}
          {% if activePartners.length %}
          <div class="shop-partners"><span>Hangi marketten sipariş vermek istersin?</span>{% for p in activePartners %}<a class="partner{% if p.logo %} has-logo{% endif %}" data-partner="{{ p.k }}" href="{{ p.url }}" target="_blank" rel="noopener">{% if p.logo %}<img src="{{ p.logo | link }}" alt="{{ p.name }}">{% else %}{{ p.name }}{% endif %}<em class="last-tag">son kullandığın</em></a>{% endfor %}</div>
          <p class="shop-hint">Butona basınca liste kopyalanır; uygulamada aratıp sepete ekleyebilirsin.</p>
          {% endif %}
          <p class="shop-msg" id="shopMsg" role="status"></p>
        </div>
      </aside>
      {% set slot = 'atf' %}{% include "ad.njk" %}
      </div>

      <div class="method">
        <div class="r-intro">{{ content | safe }}</div>
        <h2>Yapılışı</h2>
        <ol class="steps">
          {% for st in steps %}
          <li id="adim-{{ loop.index }}">
            <div class="st-no mono">{{ loop.index }}</div>
            <div class="st-body">
              <h3>{{ st.t }}{% if st.time %} <span class="st-time mono">{{ st.time }}</span>{% endif %}</h3>
              <p>{{ st.d }}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
        {% if airfryer %}
        <div class="af-note" id="airfryer"><h2>Airfryer’da nasıl yapılır?</h2><p>{{ airfryer }}</p></div>
        {% endif %}
        {% set slot = 'incontent' %}{% include "ad.njk" %}
        {% if tips and tips.length %}
        <div class="tips">
          <h2>Püf noktaları</h2>
          <ul>{% for t in tips %}<li>{{ t }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {%- set rt = ratings[page.fileSlug] -%}
        <div class="rate" id="puan" data-slug="{{ page.fileSlug }}">
          <h2>Bu tarifi denedin mi?</h2>
          <p class="rate-sum" id="rateSum">{% if rt and rt.count %}<b>{{ rt.avg }}</b> / 5 · {{ rt.count }} oy{% else %}Henüz oy yok, ilk puanı sen ver.{% endif %}</p>
          <div class="stars" role="radiogroup" aria-label="Tarifi 1 ile 5 arasında puanla">
            {% for i in range(1, 6) %}<button type="button" class="star" role="radio" aria-checked="false" data-r="{{ i }}" aria-label="{{ i }} yıldız"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg></button>{% endfor %}
          </div>
          <p class="rate-msg" id="rateMsg" aria-live="polite"></p>
        </div>
        {% if subs and subs.length %}
        <div class="subs" id="yerine">
          <h2>Elinde yoksa ne kullanırsın?</h2>
          <dl>{% for x in subs %}<div><dt>{{ x.n }}</dt><dd>{{ x.y }}</dd></div>{% endfor %}</dl>
        </div>
        {% endif %}
        {% if notes and notes.length %}
        <section class="knotes" id="notlar" aria-labelledby="notlarBaslik">
          <h2 id="notlarBaslik">Mutfaktan notlar</h2>
          {% for x in notes %}<div class="kn"><h3>{{ x.t }}</h3>{% for para in (x.d | string).split('\n\n') %}<p>{{ para }}</p>{% endfor %}</div>{% endfor %}
        </section>
        {% endif %}
        {% if editorNote %}
        {%- set ed2 = (editor or site.publisher.editorSlug) | person(authors) -%}
        <aside class="ednote" aria-label="Editörün notu"><h2>Editörün notu</h2><p>{{ editorNote }}</p>{% if ed2 %}<p class="ednote-by">{{ ed2.name }}{% if not ed2.team %} · {{ ed2.role }}{% endif %}</p>{% endif %}</aside>
        {% endif %}
        {% if faq and faq.length %}
        <section class="faq" id="sss" aria-labelledby="sssBaslik">
          <h2 id="sssBaslik">Sık sorulanlar</h2>
          {% for x in faq %}<details{% if loop.first %} open{% endif %}><summary>{{ x.q }}</summary><p>{{ x.a }}</p></details>{% endfor %}
        </section>
        {% endif %}
      </div>
    </div>
  </article>
</div>

{% if youtube or videoUrl %}
<section class="video-band" id="video" aria-label="Video tarif">
  <div class="wrap vrow">
    {% if videoUrl %}
    <div class="yt yt-live player-wrap">
      <video-js id="mmPlayer" class="video-js vjs-fill vjs-big-play-centered" controls preload="none" playsinline{% if image %} poster="{{ image | imgUrl(1200) }}"{% endif %} data-src="{{ videoUrl }}" data-title="{{ title }}"></video-js>
    </div>
    {% elif youtube %}
    <div class="yt yt-live">
      <iframe src="https://www.youtube-nocookie.com/embed/{{ youtube }}" title="{{ title }}" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
    {% else %}
    <div class="yt" role="img" aria-label="{{ title }} videosu için yer">
      <div class="thumb">{% visual { image: image, imageAlt: '', title: title, art: art }, 'scene', page.fileSlug %}</div>
      <span class="shade"></span>
      <span class="chan"><i>m</i>mesai·mutfak</span>
      <span class="pbtn"><svg viewBox="0 0 16 16"><path d="M3 1.5l11 6.5-11 6.5z"/></svg></span>
      <span class="note">Video yakında{% if videoLen %} · {{ videoLen }}{% endif %}</span>
    </div>
    {% endif %}
    <div class="vinfo">
      <div class="eyebrow">Video tarif{% if videoLen %} · {{ videoLen }}{% endif %}</div>
      <h2>{{ title }}</h2>
      {% if chapters and chapters.length %}
      <p>Ölçüler ekranda, süreler tencerenin yanında. Bölümlere göre izle.</p>
      <ol class="chapters">{% for ch in chapters %}<li><span class="t">{{ ch.t }}</span><span>{{ ch.l }}<em>{{ ch.d }}</em></span></li>{% endfor %}</ol>
      {% elif site.youtube %}
      <p>Yeni video tarifler için YouTube kanalımıza abone olabilirsin.</p>
      <a class="yt-link" href="{{ site.youtube }}" target="_blank" rel="noopener"><svg viewBox="0 0 16 16"><path d="M4 2.5l10 5.5-10 5.5z"/></svg>Kanala abone ol</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
<div class="wrap ad-row ad-row-video">{% set slot = 'leader' %}{% include "ad.njk" %}</div>

{%- set rel = collections.tarifler | related(me) -%}
{% if rel.length %}
<section class="block">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Bunu sevdiysen</div><h2>Benzer tarifler</h2></div></div>
    <div class="grid">{% for r in rel %}{% include "card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

<script>(function(){var box=document.getElementById('puan');if(!box)return;var slug=box.dataset.slug,K='mm-puan-'+slug,stars=[].slice.call(box.querySelectorAll('.star')),sum=document.getElementById('rateSum'),msg=document.getElementById('rateMsg'),api='/.netlify/functions/puan';
function paint(n){stars.forEach(function(b,i){b.classList.toggle('on',i<n);b.setAttribute('aria-checked',i+1===n?'true':'false')})}
function show(d){if(d&&d.count){sum.innerHTML='<b>'+String(d.avg).replace('.',',')+'</b> / 5 · '+d.count+' oy'}}
var mine=0;try{mine=+localStorage.getItem(K)||0}catch(e){}if(mine){paint(mine);msg.textContent='Puanın: '+mine+' yıldız. Teşekkürler!'}
fetch(api+'?s='+slug).then(function(r){return r.ok?r.json():null}).then(show).catch(function(){});
stars.forEach(function(b){b.addEventListener('mouseenter',function(){if(!mine)paint(+b.dataset.r)});b.addEventListener('mouseleave',function(){paint(mine)});
b.addEventListener('click',function(){if(mine){msg.textContent='Bu tarifi zaten puanladın.';return}var r=+b.dataset.r;paint(r);msg.textContent='Kaydediliyor…';
fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({s:slug,r:r})}).then(function(x){return x.json().then(function(d){return{ok:x.ok,d:d}})}).then(function(o){
if(o.ok){mine=r;try{localStorage.setItem(K,r)}catch(e){}show(o.d);msg.textContent='Teşekkürler! Puanın kaydedildi.';if(window.gtag)gtag('event','tarif_puan',{tarif:slug,puan:r})}
else if(o.d&&o.d.error==='tekrar'){mine=r;try{localStorage.setItem(K,r)}catch(e){}msg.textContent='Bu tarifi bugün zaten puanladın.'}else{paint(0);msg.textContent='Kaydedilemedi, tekrar dene.'}}).catch(function(){paint(0);msg.textContent='Kaydedilemedi, tekrar dene.'})})});})();</script>
<script>(function(){var h=location.hostname;if(!/mesaimutfak\.com$/.test(h))return;try{var u='/.netlify/functions/goruntulenme',b='{{ page.fileSlug }}';if(navigator.sendBeacon)navigator.sendBeacon(u,new Blob([b],{type:'text/plain'}));else fetch(u,{method:'POST',body:b,keepalive:true})}catch(e){}})();</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": {{ title | dump | safe }},
  "description": {{ desc | dump | safe }},
  "image": [{{ (site.url + ((image or site.ogImage) | imgUrl(1600))) | dump | safe }}, {{ (site.url + ((image or site.ogImage) | imgUrl(1200))) | dump | safe }}],
  {% if au %}"author": {"@type": "Person", "name": {{ au.name | dump | safe }}, "url": "{{ site.url }}/yazar/{{ au.slug }}/"},{% else %}"author": {"@type": "Organization", "name": {{ site.name | dump | safe }}, "url": {{ site.url | dump | safe }}},{% endif %}
  {% if updated %}"dateModified": "{{ updated }}",{% endif %}
  "publisher": {"@type": "Organization", "name": {{ site.name | dump | safe }}, "url": {{ site.url | dump | safe }}, "logo": {"@type": "ImageObject", "url": "{{ site.url }}/favicon.svg"}},
  "datePublished": "{{ page.date.toISOString().slice(0,10) }}",
  "keywords": {{ (title + ' tarifi, ' + title + ' nasıl yapılır, ' + (cats | catLabels(categories))) | dump | safe }},
  "prepTime": "PT{{ prep }}M",
  "cookTime": "PT{{ cook }}M",
  "totalTime": "PT{{ prep + cook }}M",
  "recipeYield": "{{ serv }} kişilik",
  "recipeCategory": {{ (catKey | catLabel(categories)) | dump | safe }},
  "recipeCuisine": "Türk",{% set rt = ratings[page.fileSlug] %}{% if rt and rt.count %}
  "aggregateRating": {"@type": "AggregateRating", "ratingValue": "{{ rt.avg }}", "ratingCount": "{{ rt.count }}", "bestRating": "5", "worstRating": "1"},{% endif %}
  "inLanguage": "tr",
  "recipeIngredient": [{% for grp in ingredients %}{% for it in grp.items %}{{ ((it.a | amt) + ' ' + (it.u or '') + ' ' + it.n) | trim | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}{% if not loop.last %},{% endif %}{% endfor %}],
  "recipeInstructions": [{% for st in steps %}{"@type": "HowToStep", "name": {{ st.t | dump | safe }}, "text": {{ st.d | dump | safe }}, "url": "{{ site.url }}{{ page.url }}#adim-{{ loop.index }}"{% if st.img %}, "image": {{ (site.url + (st.img | imgUrl(1200))) | dump | safe }}{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}]{% if youtube %},
  "video": {"@type": "VideoObject", "name": {{ title | dump | safe }}, "embedUrl": "https://www.youtube.com/embed/{{ youtube }}", "thumbnailUrl": "https://i.ytimg.com/vi/{{ youtube }}/hqdefault.jpg", "uploadDate": "{{ page.date.toISOString() }}"}{% endif %}
}
</script>
{% if faq and faq.length %}<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{% for x in faq %}{"@type": "Question", "name": {{ x.q | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ x.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>{% endif %}
<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  {"@type": "ListItem", "position": 1, "name": "Ana sayfa", "item": "{{ site.url }}/"},
  {"@type": "ListItem", "position": 2, "name": {{ (catKey | catLabel(categories)) | dump | safe }}, "item": "{{ site.url }}/kategori/{{ catKey }}/"},
  {"@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}"}
]}
</script>
