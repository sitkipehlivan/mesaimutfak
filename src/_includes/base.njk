<!doctype html>
{%- set pageType = 'home' if isHome else ('tarif' if layout == 'recipe.njk' else ('kategori' if cat else 'diger')) -%}
<html lang="tr"{% if site.ga4 %} data-ga4="{{ site.ga4 }}"{% endif %} data-ads="{{ {enabled: site.ads.enabled, network: site.ads.network, prefix: site.ads.prefix, interstitial: site.ads.interstitial, anchor: site.ads.anchor, vastTag: site.ads.vastTag, mode: site.ads.mode, adsense: site.ads.adsense, client: site.adsenseClient} | dump }}" data-page-type="{{ pageType }}" data-cat="{{ (cats[0] if cats else (cat.k if cat else '')) }}" data-slug="{{ page.fileSlug if layout == 'recipe.njk' else '' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set metaTitle = (seoTitle or title) if (title and not isHome) else '' -%}
{%- set metaDesc = seoDesc or desc or site.description -%}
{%- set ogImg = (site.url + (image | imgUrl(1200))) if image else (site.url + (site.ogImage | imgUrl(1200))) -%}
<title>{% if metaTitle %}{{ metaTitle }} | {{ site.name }}{% else %}{{ site.name }}: Pratik ve kolay yemek tarifleri{% endif %}</title>
<meta name="description" content="{{ metaDesc }}">
<meta name="robots" content="{% if page.url == '/404.html' or noindex %}noindex{% else %}index, follow, max-image-preview:large{% endif %}">
<meta name="theme-color" content="#F6F8F2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'recipe.njk' %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ metaTitle or (site.name + ': Pratik ve kolay yemek tarifleri') }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ ogImg }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle or site.name }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ ogImg }}">
{% if site.googleVerification %}<meta name="google-site-verification" content="{{ site.googleVerification }}">{% endif %}
<meta property="og:locale" content="tr_TR">
<link rel="icon" href="{{ '/favicon.svg' | link }}" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png">
<meta name="theme-color" content="#F6F8F2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Mesai Mutfak">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
{% if site.ga4 %}<script>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
(function(){var c=null;try{c=localStorage.getItem('mm-consent')}catch(e){}var g=c==='yes'?'granted':'denied',a=(c==='yes'||c==='stat')?'granted':'denied';
gtag('consent','default',{analytics_storage:a,ad_storage:g,ad_user_data:g,ad_personalization:g,wait_for_update:500});
gtag('set','ads_data_redaction',g==='denied');gtag('set','url_passthrough',false);})();
gtag('js',new Date());gtag('config','{{ site.ga4 }}');
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>{% endif %}
<script>try{if(matchMedia('(display-mode: standalone)').matches||navigator.standalone)document.documentElement.classList.add('is-app')}catch(e){}try{var t=localStorage.getItem('mm-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="{{ '/assets/style.css' | link }}?v={{ build.time }}">
{% block head %}{% endblock %}
{% if site.adsenseClient %}<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>{% endif %}
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="logo" href="{{ '/' | link }}" aria-label="{{ site.name }} ana sayfa">
      <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="5" y="15" width="30" height="19" rx="5" fill="var(--sun)" stroke="var(--ink)" stroke-width="2.5"/><rect x="10" y="9" width="20" height="5" rx="2.5" fill="var(--ink)"/><rect x="18" y="5" width="4" height="5" rx="2" fill="var(--ink)"/></svg>
      mesai·mutfak
    </a>
    <nav class="main" aria-label="Ana menü">
      <a href="{{ '/tarifler/' | link }}">Tarifler</a>
      <a href="{{ '/#kategoriler' | link }}">Kategoriler</a>
      <a href="{{ '/kategori/hizli/' | link }}">Hızlı Tarifler</a>
      <a href="{{ '/bugun-ne-pisirsem/' | link }}" class="nav-tool">Bugün ne pişirsem?</a>
      <a href="{{ '/asistan/' | link }}" class="talk-btn talk-nav" data-voice aria-label="Bizimle konuş: sesle tarif sor"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2z"/></svg><span><b>Bizimle konuş</b><em>Anlat, yemeği biz seçelim</em></span></a>
    </nav>
    <form class="hsearch" role="search" action="{{ '/ara/' | link }}">
      <label for="hq" class="sr-only">Tarif ara</label>
      <input id="hq" name="q" type="search" placeholder="Tarif ara" autocomplete="off">
      <button type="submit" aria-label="Ara"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
    </form>
    <a class="theme voice-ico" href="{{ '/asistan/' | link }}" data-voice aria-label="Sesle tarif sor"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2z"/></svg></a>
    <a class="theme favlink" href="/kaydettiklerim/" aria-label="Kaydettiklerim"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><i id="favCount" hidden></i></a>
    <button class="theme" id="themeBtn" aria-label="Koyu temaya geç"><svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg><svg class="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></button>
    {% if site.youtube %}<a class="yt-link" href="{{ site.youtube }}" target="_blank" rel="noopener"><svg viewBox="0 0 16 16"><path d="M4 2.5l10 5.5-10 5.5z"/></svg>YouTube</a>{% endif %}
  </div>
  <nav class="topcats" aria-label="Kategoriler">
    <div class="wrap">
      <a href="{{ '/yeni-tarifler/' | link }}"{% if page.url == '/yeni-tarifler/' %} aria-current="page"{% endif %}>Yeni eklenenler</a>
      {% for c in allcats %}<a href="{{ ('/kategori/' + c.k + '/') | link }}"{% if page.url == '/kategori/' + c.k + '/' %} aria-current="page"{% endif %}{% if c.wc %} class="wc"{% endif %}>{{ c.l }}</a>{% endfor %}
    </div>
    <button type="button" class="tc-arrow tc-prev" aria-label="Kategorileri sola kaydır" hidden>‹</button>
    <button type="button" class="tc-arrow tc-next" aria-label="Kategorileri sağa kaydır" hidden>›</button>
  </nav>
</header>
{% if not isHome %}{% set slot = 'masthead' %}<div class="wrap ad-row">{% include "ad.njk" %}</div>{% endif %}
{% set slot = 'rail_left' %}{% include "ad.njk" %}{% set slot = 'rail_right' %}{% include "ad.njk" %}{% set slot = 'anchor' %}{% include "ad.njk" %}

<main id="top">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <span>© 2026 mesaimutfak.com</span>
    <nav class="foot-nav" aria-label="Alt menü">
      <a href="{{ '/tarifler/' | link }}">Tüm tarifler</a>
      <a href="{{ '/bugun-ne-pisirsem/' | link }}">Bugün ne pişirsem?</a>
      <a href="{{ '/listem/' | link }}">Alışveriş listem</a>
      <a href="/kaydettiklerim/">Kaydettiklerim</a>
      <a href="/yapay-zeka/">Yapay zekâ ile kullan</a>
      <button type="button" class="linkbtn" id="installBtn" hidden>Uygulamayı yükle</button>
      <a href="{{ '/kategori/vegan/' | link }}">Vegan</a>
      <a href="{{ '/kategori/glutensiz/' | link }}">Glutensiz</a>
      <a href="{{ '/hakkimizda/' | link }}">Hakkımızda</a>
      <a href="{{ '/kunye/' | link }}">Künye</a>
      <a href="{{ '/iletisim/' | link }}">İletişim</a>
      <a href="{{ '/reklam/' | link }}">Reklam</a>
      <a href="{{ '/gizlilik/' | link }}">Gizlilik</a>
      {% if site.ga4 or site.ads.enabled %}<a href="#" data-consent-open>Çerez tercihleri</a>{% endif %}
      {% if collections.photos.length %}<a href="{{ '/fotograf-kaynaklari/' | link }}">Fotoğraf kaynakları</a>{% endif %}
    </nav>
    {% if site.youtube %}<a class="yt-link" href="{{ site.youtube }}" target="_blank" rel="noopener"><svg viewBox="0 0 16 16"><path d="M4 2.5l10 5.5-10 5.5z"/></svg>Kanala abone ol</a>{% endif %}
  </div>
</footer>
{% if site.ga4 or site.ads.enabled %}<div class="consent" id="consent" hidden role="dialog" aria-label="Çerez tercihi">
  <p>Siteyi geliştirmek için anonim ziyaret istatistikleri topluyor{% if site.ads.enabled %} ve ilgi alanına göre reklam gösteriyor{% endif %}uz. Hangisine izin veriyorsun? <a href="{{ '/gizlilik/' | link }}">Gizlilik</a></p>
  <div class="consent-btns"><button type="button" class="btn" id="consentYes">Tümünü kabul et</button><button type="button" class="btn ghost" id="consentStat">Sadece istatistik</button><button type="button" class="btn cn-no" id="consentNo">Reddet</button></div>
</div>{% endif %}
<nav class="tabbar" aria-label="Uygulama menüsü">
  <a href="/"{% if isHome %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/></svg>Ana sayfa</a>
  <a href="/ara/"{% if page.url == '/ara/' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Ara</a>
  <a href="/bugun-ne-pisirsem/"{% if page.url == '/bugun-ne-pisirsem/' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M5 11h14v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"/><path d="M3 11h18M9 7c0-1 1-1 1-2M14 7c0-1 1-1 1-2"/></svg>Ne pişirsem</a>
  <a href="/kaydettiklerim/"{% if page.url == '/kaydettiklerim/' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>Kaydettiklerim</a>
  <a href="/listem/"{% if page.url == '/listem/' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>Listem</a>
</nav>
<script src="{{ '/assets/site.js' | link }}?v={{ build.time }}"></script>
<script src="{{ '/assets/ads.js' | link }}?v={{ build.time }}" defer></script>
<script src="{{ '/assets/app.js' | link }}?v={{ build.time }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
